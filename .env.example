# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_RECONNECT_BASE_MS=1000

# PostgreSQL
DATABASE_URL=postgresql://app:app@postgres:5432/events
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Producer
PRODUCER_PORT=3001

# Consumer
CONSUMER_PORT=3002

# Telegram service
TELEGRAM_PORT=3003
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here

NODE_ENV=development
